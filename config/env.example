# Better_Jarvis Environment Configuration Template
# Copy this file to .env in the repository root and fill in your credentials.

# Required for Google AI Studio models (fast_model, fallback_model, and AI Studio routing)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: Path to Google Cloud Application Default Credentials JSON for Vertex AI Enterprise routing
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YourName\AppData\Roaming\gcloud\application_default_credentials.json

# Optional: Override AI provider ("auto", "google_ai_studio", or "vertex_ai") via config/config.toml [ai].provider
