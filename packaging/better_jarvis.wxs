<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Better_Jarvis"
           Manufacturer="Better_Jarvis Engineering"
           Version="1.0.0"
           UpgradeCode="4C7A87A5-E1A4-4A2D-A2A9-49A3C23B19B2"
           Scope="perUser">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Better_Jarvis" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Better_Jarvis" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="HostExecutable" Guid="3F279A8F-09DE-4581-9988-5F52FE38D8B1">
        <File Id="JarvisHostExe" Source="..\dist\Better_Jarvis-v1.0.0-win64\jarvis-host.exe" KeyPath="yes">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Better_Jarvis"
                    Description="Better_Jarvis C++20/Rust Voice Assistant"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes" />
        </File>
      </Component>

      <Component Id="DaemonExecutable" Guid="1BE229A1-F648-43B6-848D-75C8CE4E20B8">
        <File Id="JarvisDaemonExe" Source="..\dist\Better_Jarvis-v1.0.0-win64\jarvis-daemon.exe" KeyPath="yes" />
      </Component>

      <Component Id="ApplicationShortcutRef" Guid="6A1A7FE2-C84C-485F-82D1-79A81E482FB9">
        <RemoveFolder Id="CleanUpProgramMenuDir" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Better_Jarvis" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainApplication" Title="Better_Jarvis Application" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <Files Include="..\dist\Better_Jarvis-v1.0.0-win64\*.dll" />
    </Feature>
  </Package>
</Wix>
